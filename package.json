{
  "name": "eyewear-assistant",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.4.2",
  "description": "Virtual glasses try-on in the browser: MediaPipe face tracking + Three.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "dev:https": "vite --mode https --host 0.0.0.0 --port 5178 --strictPort",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prepare:models": "node scripts/copy-mediapipe.mjs",
    "generate:frames": "node scripts/generate-frame-assets.mjs",
    "generate:tim": "blender --background --python-exit-code 1 --python scripts/generate-tim-frames.py && python3 assets/tim-frames/finish-previews.py",
    "deploy:cloudflare": "pnpm build && pnpm dlx wrangler@4.167.0 deploy",
    "test": "node --experimental-vm-modules --experimental-strip-types --test tests/selection.test.ts tests/tryon-lifecycle.test.mjs tests/tracking-fit.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
